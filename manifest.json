{
  "manifest_version": 2,
  "name": "Tidier",
  "version": "1.6",
  "description": "Firefox in the shape of Zen and Arc: essentials and tabs in every window, live folders of GitHub pull requests, archiving of unused tabs, and ⌘⇧C to copy the address.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{6844a953-9931-4334-9ff6-257c246485cb}",
      "strict_min_version": "140.0",
      "update_url": "https://github.com/CHaerem/tidier/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "sessions",
    "storage",
    "cookies",
    "nativeMessaging",
    "alarms",
    "clipboardWrite",
    "contextualIdentities",
    "menus",
    "menus.overrideContext"
  ],
  "optional_permissions": [
    "tabHide"
  ],
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "sidebar_action": {
    "default_panel": "sidebar/sidebar.html",
    "default_title": "Tidier",
    "default_icon": "icon.svg"
  },
  "browser_action": {
    "default_title": "Tidier",
    "default_icon": "icon.svg",
    "default_area": "menupanel"
  },
  "background": {
    "scripts": [
      "common.js",
      "essentials.js",
      "tabsync.js",
      "folders.js",
      "livefolders.js",
      "spaces.js",
      "ownfolders.js",
      "foldrest.js",
      "copies.js",
      "moveover.js",
      "sidebar-view.js",
      "archive.js",
      "shortcuts.js"
    ],
    "persistent": true
  },
  "commands": {
    "copy-url": {
      "suggested_key": {
        "default": "Ctrl+Shift+C"
      },
      "description": "Copy the address of the current tab"
    },
    "_execute_sidebar_action": { "description": "Show or hide Tidier's sidebar" },
    "space-1": { "description": "Go to the first space" },
    "space-2": { "description": "Go to the second space" },
    "space-3": { "description": "Go to the third space" },
    "space-4": { "description": "Go to the fourth space" },
    "space-5": { "description": "Go to the fifth space" }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
